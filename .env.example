# =============================================================================
# Root Docker Compose & Global Environment Configuration
# =============================================================================
# Copy this file to .env to configure ports, database, and URLs.
# =============================================================================

# --- Exposed Ports -----------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
DB_PORT=5432

# --- Local PostgreSQL (used when running local db container) -----------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=salary_management

# --- Database Connection String -----------------------------------------------
# If using Supabase / external DB (pooler connection required for Docker containers):
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
# If using local Docker postgres container:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/salary_management

# --- URLs & Domain Configuration ---------------------------------------------
# Development: http://localhost:8000
# Production: https://api-incubyte.shivamshukla.tech
NEXT_PUBLIC_API_URL=https://api-incubyte.shivamshukla.tech

# --- App Settings ------------------------------------------------------------
APP_ENV=production
DEBUG=false
# Comma-separated allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:3000,https://incubyte.shivamshukla.tech
