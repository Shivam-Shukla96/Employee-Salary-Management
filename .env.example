# =============================================================================
# Root Docker Compose & Global Environment Configuration
# =============================================================================
# Copy this file to .env (or backend/.env) to configure ports, database, and URLs.
# =============================================================================

# --- Exposed Ports -----------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
DB_PORT=5432

# --- Local PostgreSQL (used when running db container) ------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=salary_management

# --- Database Connection String -----------------------------------------------
# If using Supabase / external DB, set your connection string here.
# If using the local Docker postgres container: postgresql://postgres:postgres@db:5432/salary_management
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/salary_management

# --- Frontend API Target -----------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- App Settings ------------------------------------------------------------
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000
