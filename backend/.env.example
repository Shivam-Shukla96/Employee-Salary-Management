# =============================================================================
# Salary Management API — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# .env is gitignored and should NEVER be committed.
# =============================================================================

# --- Database ----------------------------------------------------------------
# PostgreSQL connection string. REQUIRED for production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/salary_management
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/salary_management_test

# --- App ---------------------------------------------------------------------
APP_NAME=Salary Management API
APP_ENV=development          # development | staging | production
DEBUG=false
CORS_ORIGINS=http://localhost:3000

# --- Pagination --------------------------------------------------------------
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- Business Domain ---------------------------------------------------------
# Comma-separated lists. Change these to match your organization.
DEPARTMENTS=Engineering,Sales,Marketing,HR,Finance,Operations,Support,Product
COUNTRIES=US,UK,India,Germany,Japan,Brazil,Canada,Australia
COUNTRY_CURRENCY_MAP=US:USD,UK:GBP,India:INR,Germany:EUR,Japan:JPY,Brazil:BRL,Canada:CAD,Australia:AUD

# --- Exchange Rates (static seed values) -------------------------------------
# Format: CURRENCY:RATE_TO_USD (comma-separated)
EXCHANGE_RATES=USD:1.000000,GBP:1.270000,INR:0.012000,EUR:1.090000,JPY:0.006700,BRL:0.200000,CAD:0.740000,AUD:0.650000
